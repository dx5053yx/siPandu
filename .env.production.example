# App
NEXT_PUBLIC_APP_NAME=siPandu
NEXT_PUBLIC_APP_URL=https://your-sipandu-domain.vercel.app
DEFAULT_MERCHANT_ID=demo_warung_mendoan
NODE_ENV=production

# Gemini
GEMINI_API_KEY=isi_dari_google_ai_studio
GEMINI_MODEL=gemini-2.0-flash

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wPJsrDE0ON3MCv-EzWz7XA_4g9HRs5U
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkcW1vbnRzZGNkcmhmc2Vva2RtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3OTM5MTE2MywiZXhwIjoyMDk0OTY3MTYzfQ.e3ZQQW57bkAzgiUINC6C05J355IDopMaM3aORgmMvec

# Chat / WhatsApp Gateway
CHAT_WEBHOOK_SECRET=buat_secret_random_min_32_char
WHATSAPP_PHONE_NUMBER=628997595299

# For Vercel + local OpenClaw forwarder, keep provider mock.
# The OpenClaw plugin sends the WhatsApp reply after siPandu returns text.
WHATSAPP_PROVIDER=mock

# OpenClaw automation webhook into siPandu
OPENCLAW_WEBHOOK_SECRET=buat_secret_random_min_32_char
OPENCLAW_ROUTE_PATH=/plugins/webhooks/sipandu
OPENCLAW_SESSION_KEY=agent:sipandu:main

# Optional only if the deployed app can reach a public OpenClaw gateway.
# Do not set localhost gateway URLs on Vercel.
# OPENCLAW_GATEWAY_URL=https://your-openclaw-gateway.example.com
# OPENCLAW_WA_SESSION_ID=default
# OPENCLAW_WA_QR_PATH=/plugins/whatsapp/qr
